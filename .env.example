# CLOVA Studio API (nv- 단일 키)
CLOVA_API_KEY=nv-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOVA_HOST=https://clovastudio.stream.ntruss.com
CLOVA_MODEL=HCX-005

# Database
# 로컬: sqlite / Render: 127.0.0.1:13306 (tailscale_proxy 경유)
# NAS:  mysql+asyncmy://<user>:<pw>@127.0.0.1:3306/<db>  ← 포워더 없이 직결
DATABASE_URL=sqlite+aiosqlite:///./hdauto.db

# 실행 위치 표시용(local | render | nas). 비우면 DATABASE_URL로 추정한다.
RUNTIME_ENV=
# 매뉴얼 PDF 업로드 라우터. 메모리를 많이 먹어 Render에서는 끈다.
# sqlite(로컬)에서는 이 값과 무관하게 자동으로 켜진다.
ENABLE_MANUAL_UPLOAD=false

# 현대자동화 위치 정보 (실제 값으로 교체)
COMPANY_NAME=현대자동화 현대기전사
COMPANY_ADDRESS=부산광역시 OO구 OO로 OO
COMPANY_PHONE=051-000-0000
COMPANY_LAT=35.1796
COMPANY_LNG=129.0756
COMPANY_HOURS=평일 09:00~18:00

# 네이버 톡톡 (파트너센터에서 발급)
TALKTALK_AUTHORIZATION=
# 아래 둘 중 하나는 반드시 채워야 웹훅이 열린다(운영 모드는 fail-closed).
# SECRET: 톡톡이 X-NAVER-BOT-Signature를 보낼 때 쓰는 HMAC 키.
# WEBHOOK_KEY: 서명이 없을 때의 대안. 파트너센터 웹훅 URL을
#              https://.../api/talktalk/webhook?k=<이 값> 으로 등록한다.
TALKTALK_SECRET=
TALKTALK_WEBHOOK_KEY=

# 네이버 커머스API (실시간 재고 조회용 - 검색API와는 별개, 커머스API센터에서 발급)
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=
NAVER_COMMERCE_ENABLED=false

# 슬랙 재고 알림 (선택)
SLACK_WEBHOOK_URL=

# 재고/가격 설정
DEFAULT_STOCK_THRESHOLD=3
PRICE_DIFF_THRESHOLD=10.0
